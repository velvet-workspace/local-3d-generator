{
  "name": "local-3d-generator",
  "version": "0.2.47",
  "private": true,
  "type": "module",
  "description": "Independent local-first 3D workbench; G1 demo plus opt-in G2 guarded TripoSR adapter",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "fixture": "node server/fixture.js",
    "qa:browser": "node tests/browser-qa.mjs",
    "test:all": "npm test && npm run qa:browser && npm run qa:browser-g2-mock",
    "preflight:g2": "node scripts/g2-preflight.mjs --out runtime/qa/g2-preflight.json",
    "qa:browser-g2-mock": "node tests/g2-browser-qa.mjs",
    "audit:g3:storage": "node scripts/g3-storage-audit.mjs",
    "audit:g3:gpu-lock": "node scripts/g3-inspect-gpu-lease.mjs",
    "audit:g3:pillow-upgrade": "node scripts/g3-35-assemble-pillow-upgrade-gate.mjs",
    "smoke:g3:g1-recovery": "node scripts/g3-36-g1-fixture-recovery-smoke.mjs",
    "proof:g3:g1-recovery": "node scripts/g3-36-assemble-fixture-recovery-readiness.mjs",
    "audit:g3:pillow-shadow-quality": "node scripts/g3-37-assemble-shadow-quality-proof.mjs",
    "benchmark:g3": "node scripts/g3-collect-benchmark.mjs",
    "score:g3": "node scripts/g3-score-existing-job.mjs",
    "proof:g3:cpu": "node scripts/g3-4-actual-cpu-review-proof.mjs",
    "audit:g3:admission": "node scripts/g3-5-storage-readiness.mjs",
    "audit:g3:python-osv": "node scripts/g3-5-dependency-screen.mjs",
    "audit:g3:pillow-shadow-public": "node scripts/g3-6-pillow-candidate-screen.mjs",
    "proof:g3:orb:cpu": "node scripts/g3-7-assemble-orb-evidence.mjs",
    "proof:g3:orb:risk": "node scripts/g3-8-assemble-cpu-risk-evidence.mjs",
    "proof:g3:orb:edge": "node scripts/g3-9-assemble-adjacent-evidence.mjs",
    "proof:g3:orb:vertex": "node scripts/g3-10-assemble-vertex-evidence.mjs",
    "proof:g3:orb:edge-backfold": "node scripts/g3-11-assemble-edge-proof.mjs",
    "proof:g3:orb:spatial": "node scripts/g3-12-assemble-spatial-proof.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "playwright-core": "1.64.0"
  }
}
